# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tool output. `main/out/` is where every command in docs/ writes by default.
# Everything in it is regenerable from `fixtures/` + the engine; nothing here
# is a source of truth.
out/
!out/.gitkeep

# Transient LLVM build products (the llvm/ tools write here)
llvm/build/
*.obj
*.dll
*.lib
*.exp
*.ilk
*.pdb
*.ll.json

# Local environment
.venv/
venv/
.env

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Ghidra run products: the projects and decompilation logs are regenerated by
# llvm/ghidra/decomp_stats.py and llvm/frontier_control.py. The sources
# (Decompile.java, Frontier.java, decomp_stats.py) are tracked.
llvm/ghidra/proj/
llvm/ghidra/out/
